# --- Service ---
STT_ADDR=127.0.0.1:8080
STT_PROFILE=local                 # local | production
STT_STORE=memory                  # memory | sqlite | postgres (production requires sqlite|postgres)
STT_DEFAULT_ENGINE=python:mock    # python:<mock|faster_whisper|mlx_whisper|parakeet_mlx> or a cloud provider
STT_QUEUE_WORKERS=2
STT_ENGINE_TIMEOUT=30m            # cap for one transcription (Go duration)

# --- Python worker ---
STT_WORKER_URL=http://127.0.0.1:8090
STT_WORKER_AUTOSTART=false         # autostart the py-stt worker (one-command local run)
STT_WORKER_CMD=
STT_WORKER_DIR=../py-stt

# --- Cloud STT APIs (production profile; Go calls these directly) ---
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
